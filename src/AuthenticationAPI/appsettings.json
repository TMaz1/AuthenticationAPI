{
  "ConnectionStrings": {
    "DefaultConnection": "<SQL_SERVER_CONNECTION_STRING>",
    "Redis": "<REDIS_CONNECTION_STRING>"
  },
  "AppSettings": {
    "AppName": "App Name",
    "AppLink": "https://frontend-url.example.com",
    "Key": "<JWT_SECRET_KEY>",
    "PreviousKeys": [],
    "Issuer": "https://api-url.example.com",
    "Audience": "https://api-url.example.com",
    "AccessTokenExpiration": 15,
    "RefreshTokenExpiration": 7,
    "RememberMeRefreshTokenExpiration": 30,
    "PasswordResetTokenExpiration": 30,
    "VerificationTokenExpiration": 24,
    "ClockSkewSeconds": 30
  },
  "Security": {
    "EncryptionKey": "<BASE64_32_BYTE_KEY>",
    "Password": { "MinLength": 10, "MaxLength": 128, "Pbkdf2Iterations": 210000 },
    "Lockout": { "WindowMinutes": 15, "AccountIpMaxFailures": 5, "AccountMaxFailures": 50, "IpMaxFailures": 100 },
    "Mfa": { "EmailOtpEnabled": true, "SmsEnabled": false, "RequireMfaForAdministrators": false },
    "TrustedDevices": { "Enabled": false, "Days": 30 },
    "Sms": { "Provider": "None" },
    "Cors": { "AllowedOrigins": [] },
    "ForwardedHeaders": { "Enabled": false, "KnownProxies": [] }
  },
  "SmtpSettings": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "Username": "<SMTP_USERNAME>",
    "Password": "<SMTP_PASSWORD>",
    "FromEmail": "<FROM_EMAIL>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
